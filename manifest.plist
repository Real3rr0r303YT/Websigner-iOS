<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  iOS OTA (over-the-air) installation manifest for WebSigner.

  Before publishing, replace every value marked "CHANGE ME":
    - software-package URL : direct HTTPS link to your signed .ipa
    - display-image URL    : 57x57 PNG icon (shown while installing)
    - full-size-image URL  : 512x512 PNG icon
    - bundle-identifier    : MUST match the CFBundleIdentifier inside the signed .ipa
    - bundle-version       : MUST match CFBundleShortVersionString / CFBundleVersion of the .ipa
    - title                : name shown in the install prompt

  Easiest: don't edit by hand. Publish a GitHub Release with the signed .ipa
  and .github/workflows/ota-release.yml regenerates this file from the IPA.
  Or generate it locally with tools/check_ipa.py (see README).

  All URLs must use HTTPS with a valid (non self-signed) certificate.
  Install link:
    itms-services://?action=download-manifest&url=https://<your-host>/manifest.plist
-->
<plist version="1.0">
<dict>
    <key>items</key>
    <array>
        <dict>
            <key>assets</key>
            <array>
                <!-- The signed IPA (required). CHANGE ME -->
                <dict>
                    <key>kind</key>
                    <string>software-package</string>
                    <key>url</key>
                    <string>https://github.com/Real3rr0r303YT/Websigner-iOS/releases/download/v1.2.0/WebSigner.ipa</string>
                </dict>
                <!-- 57x57 icon shown during installation. CHANGE ME -->
                <dict>
                    <key>kind</key>
                    <string>display-image</string>
                    <key>needs-shine</key>
                    <false/>
                    <key>url</key>
                    <string>https://real3rr0r303yt.github.io/Websigner-iOS/assets/icon-57.png</string>
                </dict>
                <!-- 512x512 full-size icon. CHANGE ME -->
                <dict>
                    <key>kind</key>
                    <string>full-size-image</string>
                    <key>needs-shine</key>
                    <false/>
                    <key>url</key>
                    <string>https://real3rr0r303yt.github.io/Websigner-iOS/assets/icon-512.png</string>
                </dict>
            </array>
            <key>metadata</key>
            <dict>
                <!-- CHANGE ME: must match the signed IPA -->
                <key>bundle-identifier</key>
                <string>com.real3rr0r303yt.websigner</string>
                <!-- CHANGE ME: must match the signed IPA -->
                <key>bundle-version</key>
                <string>1.2.0</string>
                <key>kind</key>
                <string>software</string>
                <!-- CHANGE ME: shown in the "would like to install" prompt -->
                <key>title</key>
                <string>WebSigner</string>
                <key>subtitle</key>
                <string>Direct Web Installer &amp; Signer</string>
            </dict>
        </dict>
    </array>
</dict>
</plist>
